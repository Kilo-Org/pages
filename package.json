{
  "name": "pages-programs",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "pp": "bun packages/host/src/cli.ts",
    "up": "bun packages/host/src/cli.ts up",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:portable": "bun scripts/check-portable.ts",
    "check": "bun run typecheck && bun run test && bun run check:portable"
  },
  "devDependencies": {
    "@pages-programs/sdk": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
